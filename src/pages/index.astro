---
import FloodMap from '../components/FloodMap';
import '../styles/flood-map.css';
export const prerender = true;
---
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Explore simplified Flood Zone 2 and 3 mapping across England. Search an English postcode and inspect mapped flood zones." />
    <meta name="theme-color" content="#102b3a" />
    <title>Flood Atlas — England flood-zone explorer</title>
  </head>
  <body>
    <FloodMap client:only="react" />
    <noscript>This interactive flood-zone explorer requires JavaScript. Visit the Environment Agency flood map for planning for official information.</noscript>
  </body>
</html>
